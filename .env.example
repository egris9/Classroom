# Copy to .env in the repo root and fill in. .env is git-ignored.
# Start the backend from the repo root so Spring finds it.

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

DB_URL=jdbc:mysql://localhost:3306/classroom
DB_USERNAME=root
DB_PASSWORD=

# Folder for uploaded PDFs and profile pictures.
UPLOAD_DIR=uploads

# Optional size limits (defaults: 20MB per course file, 2MB per profile picture).
# UPLOAD_MAX_SIZE=20MB
# UPLOAD_MAX_PICTURE_SIZE=2MB

# Text generation. "fake" needs no model; "local" calls a chat-completions server such as llama.cpp.
GENERATION_ADAPTER=local
GENERATION_BASE_URL=http://127.0.0.1:8081
GENERATION_MODEL=unsloth/Qwen3.5-4B-GGUF:Q4_K_M
# GENERATION_TIMEOUT=120s
# A long or extra long summary gets a longer time limit per call, and every summary a token cap by level
# (short, medium, long, extra long). A summary the cap cuts off fails and is not stored.
# GENERATION_LONG_TIMEOUT=240s
# GENERATION_SUMMARY_MAX_TOKENS=400,900,1550,2450
# GENERATION_CHUNK_CHARS=10000
# GENERATION_MAX_CHUNKS=40

# OCR for course PDFs that have no text (scans) or garbled text. Off unless the adapter is "tesseract":
# with "none", or with these lines left out, PDFs are read from their own text only.
# Needs Tesseract 5 installed with the language data named in GENERATION_OCR_LANGUAGES; the app refuses to start
# if the program or a language is missing. It uses the CPU only, a few seconds per page, once per file.
# GENERATION_OCR_ADAPTER=tesseract
# GENERATION_OCR_COMMAND=C:/Program Files/Tesseract-OCR/tesseract.exe
# GENERATION_OCR_LANGUAGES=ara+fra+eng
# GENERATION_OCR_DPI=300
# GENERATION_OCR_PAGE_TIMEOUT=60s
# GENERATION_OCR_MAX_PAGES=80
# GENERATION_OCR_TIMEOUT=10m

# The AI tools page: anyone may use it once without an account. Required, the app refuses to start without it.
# Any long random text; generate one with: openssl rand -hex 32
TOOLS_TRIAL_SALT=
# Only behind a proxy you run that sets X-Forwarded-For; otherwise leave it out.
# TOOLS_TRIAL_TRUST_FORWARDED=false
# Optional input limits for the AI tools (defaults: 20000 characters and 5MB for a visitor, 100000 characters signed in).
# TOOLS_ANON_MAX_CHARS=20000
# TOOLS_ANON_MAX_PDF=5MB
# TOOLS_MAX_CHARS=100000
# TOOLS_CHAT_MAX_MESSAGES=20
# TOOLS_CHAT_MAX_MESSAGE_CHARS=4000
